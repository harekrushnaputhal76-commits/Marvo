# ================================================================
# MARVO AI — .gitignore
# Prevents sensitive credentials, caches, and local data from leaks
# ================================================================

# Environment & Secrets (NEVER COMMIT REAL CREDENTIALS)
.env
.env.*
*.env
ai.env
!.env.example

# Secrets, keys, and tokens
*secret*
*token*
*key*
!key_pool.py
!test_key_pool.py
!*example*
!*template*

# Signing files
*.keystore
*.jks

# Output folders & build artifacts
dist/
build/
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/captures/
android/.idea/
android/*.iml
android/app/*.iml

# Built packages & binaries
*.apk
*.aab
*.exe
*.lnk
*.zip
marvo-debug-apk/
Voice marvo*/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Node & NPM Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs & Temporary Files
logs/
*.log
temp/
cache/

# Sessions & User Data (local conversation history)
sessions/*.json
!sessions/userdata.json

# IDE / Editor configuration
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
