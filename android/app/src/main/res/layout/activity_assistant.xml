<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/assistantRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@null">

    <!-- Step 10: Dynamic Apple-Style Notification Pill (Top Island) -->
    <LinearLayout
        android:id="@+id/dynamicPillContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_dynamic_pill"
        android:paddingStart="18dp"
        android:paddingEnd="22dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:elevation="32dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/pillIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:tint="#00E5FF"
            android:contentDescription="Action Icon"
            android:src="@android:drawable/ic_lock_silent_mode_off" />

        <TextView
            android:id="@+id/pillText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="Action Executed" />
    </LinearLayout>

    <!-- True Floating Assistant Container: 100% Absolute Native Transparency -->
    <LinearLayout
        android:id="@+id/bottomSheetContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="0dp"
        android:background="@null"
        android:gravity="center_horizontal|bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="0dp"
        android:elevation="0dp">

        <!-- Response Scroll Container positioned above the Siri Orb -->
        <ScrollView
            android:id="@+id/statusScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:scrollbars="vertical"
            android:fadeScrollbars="true"
            android:overScrollMode="ifContentScrolls"
            android:background="@null">

            <!-- Main Status Label (Listening / Processing / Action) -->
            <TextView
                android:id="@+id/statusTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="4"
                android:shadowRadius="10"
                android:text="Listening..."
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="@null" />
        </ScrollView>

        <!-- Secondary Subtitle (live transcription / command feedback) -->
        <TextView
            android:id="@+id/subtitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text=""
            android:textColor="#B300E5FF"
            android:textSize="14sp"
            android:visibility="gone"
            android:background="@null" />

        <!-- Glowing Orb Container positioned at the absolute bottom -->
        <FrameLayout
            android:id="@+id/orbContainer"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:background="@null"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp">

            <!-- Siri-style Fluid WebGL Orb (Step 7 - Part 2: True 3D Floating Liquid Orb) -->
            <WebView
                android:id="@+id/orbWebView"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:background="@null"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:layerType="hardware" />
        </FrameLayout>

    </LinearLayout>

</RelativeLayout>
