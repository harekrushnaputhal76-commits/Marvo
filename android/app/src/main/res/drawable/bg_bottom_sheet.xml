<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The 1px "Glass Edge" Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="32dp" android:topRightRadius="32dp" />
            <solid android:color="#40FFFFFF" /> <!-- 25% white border -->
        </shape>
    </item>

    <!-- The Translucent Dark Glass Body (inset slightly to show the border) -->
    <item android:bottom="0dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="31dp" android:topRightRadius="31dp" />
            <solid android:color="#60000000" /> <!-- 37% Black -->
        </shape>
    </item>
</layer-list>
