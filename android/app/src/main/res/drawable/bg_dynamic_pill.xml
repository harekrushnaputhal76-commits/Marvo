<?xml version="1.0" encoding="utf-8"?>
<!-- Apple Dynamic Island Style Frosted Translucent Pill Background -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 1: Outer Glass Highlight Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke
                android:width="1.2dp"
                android:color="#55FFFFFF" />
            <solid android:color="#00000000" />
        </shape>
    </item>

    <!-- Layer 2: Deep Frosted Dark Translucent Fill -->
    <item
        android:top="1dp"
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <gradient
                android:type="linear"
                android:startColor="#E6181B22"
                android:endColor="#E60D0F14"
                android:angle="270" />
        </shape>
    </item>
</layer-list>

