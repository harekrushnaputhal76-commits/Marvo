<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: Wide ambient outer aura (soft electric blue diffusion) -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="64dp"
                android:startColor="#500078FF"
                android:centerColor="#2800B4FF"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Layer 2: Mid-range neon glow ring -->
    <item android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="48dp"
                android:startColor="#8000E5FF"
                android:centerColor="#4000D4FF"
                android:endColor="#0000E5FF" />
        </shape>
    </item>

    <!-- Layer 3: Deep neon cyan core -->
    <item android:left="16dp" android:right="16dp" android:top="16dp" android:bottom="16dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="28dp"
                android:startColor="#FFFFFFFF"
                android:centerColor="#FF00E5FF"
                android:endColor="#CC0088FF" />
        </shape>
    </item>

    <!-- Layer 4: Bright white-hot center pinpoint -->
    <item android:left="28dp" android:right="28dp" android:top="28dp" android:bottom="28dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="12dp"
                android:startColor="#FFFFFFFF"
                android:endColor="#B0FFFFFF" />
        </shape>
    </item>

</layer-list>
