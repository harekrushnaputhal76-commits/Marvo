<?xml version="1.0" encoding="utf-8"?>
<!-- Premium 3D Watermorphism Bottom Sheet — Step 9 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: Outermost soft neon glow halo (simulates ambient light bleed) -->
    <!-- Layer 1: Outer highlight border (frosted glass edge) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="38dp" android:topRightRadius="38dp" />
            <solid android:color="#1A00E5FF" /> <!-- 10% neon cyan ambient -->
            <corners
                android:topLeftRadius="40dp"
                android:topRightRadius="40dp" />
            <stroke
                android:width="1.5dp"
                android:color="#66FFFFFF" />
            <solid android:color="#00000000" />
        </shape>
    </item>

    <!-- Layer 2: Bright 1.5dp top-edge highlight border (frosted glass edge) -->
    <item android:top="2dp">
    <!-- Layer 2: Deep frosted dark translucent fill -->
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="36dp" android:topRightRadius="36dp" />
            <stroke android:width="1.5dp" android:color="#80FFFFFF" />
            <solid android:color="@android:color/transparent" />
            <corners
                android:topLeftRadius="40dp"
                android:topRightRadius="40dp" />
            <solid android:color="#A6121212" />
        </shape>
    </item>

    <!-- Layer 3: Inner gradient frosted dark translucent fill (#90121212) -->
    <item android:left="1.5dp" android:right="1.5dp" android:top="1.5dp" android:bottom="0dp">
    <!-- Layer 3: Inner gradient for depth (subtle dark-to-darker) -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="36dp" android:topRightRadius="36dp" />
            <corners
                android:topLeftRadius="39dp"
                android:topRightRadius="39dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#95121212"
                android:centerColor="#90121212"
                android:endColor="#A0121212" />
                android:startColor="#CC1A1D24"
                android:endColor="#CC0F1117"
                android:angle="270" />
        </shape>
    </item>

    <!-- Layer 4: Subtle inner top shine (simulates light refraction on glass) -->
    <item android:left="8dp" android:right="8dp" android:top="2dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="34dp" android:topRightRadius="34dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#18FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"
                android:centerY="0.15" />
        </shape>
    </item>

</layer-list>
