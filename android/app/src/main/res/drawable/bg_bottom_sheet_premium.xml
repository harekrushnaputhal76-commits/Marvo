<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: Outermost soft neon glow halo (simulates ambient light bleed) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="38dp" android:topRightRadius="38dp" />
            <solid android:color="#1A00E5FF" /> <!-- 10% neon cyan ambient -->
        </shape>
    </item>

    <!-- Layer 2: Bright 1.5dp top-edge highlight border (frosted glass edge) -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="36dp" android:topRightRadius="36dp" />
            <stroke android:width="1.5dp" android:color="#80FFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <!-- Layer 3: Inner gradient frosted dark translucent fill (#90121212) -->
    <item android:left="1.5dp" android:right="1.5dp" android:top="1.5dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="36dp" android:topRightRadius="36dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#95121212"
                android:centerColor="#90121212"
                android:endColor="#A0121212" />
        </shape>
    </item>

    <!-- Layer 4: Subtle inner top shine (simulates light refraction on glass) -->
    <item android:left="8dp" android:right="8dp" android:top="2dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="34dp" android:topRightRadius="34dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#18FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"
                android:centerY="0.15" />
        </shape>
    </item>

</layer-list>
