<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
     android:fillAfter="true"
     android:interpolator="@android:anim/accelerate_decelerate_interpolator">

    <!-- Smooth breathing scale without shifting the orb's layout bounds. -->
    <scale
        android:duration="1800"
        android:fromXScale="0.94"
        android:fromYScale="0.94"
        android:pivotX="50%"
        android:pivotY="50%"
        android:repeatCount="infinite"
        android:repeatMode="reverse"
        android:toXScale="1.08"
        android:toYScale="1.08" />

    <!-- Subtle alpha breathing to simulate light intensity change -->
    <alpha
        android:duration="1800"
        android:fromAlpha="0.82"
        android:toAlpha="1.0"
        android:repeatCount="infinite"
        android:repeatMode="reverse" />

</set>
